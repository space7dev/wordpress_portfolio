<section class="section reference-section about" id="about" aria-labelledby="about-title">
  <div class="shell">
    <header class="reference-heading scroll-reveal">
      <p class="eyebrow">Behind the code</p>
      <h2 id="about-title">About <span>me.</span></h2>
    </header>
    <div class="glass-panel about-glass scroll-reveal">
      <div class="about-glass__mark" aria-hidden="true"><span>WP</span></div>
      <div class="about-glass__copy">
        <p class="about__lead">I'm a senior WordPress developer focused on making complex websites feel refreshingly simple.</p>
        <p>For more than a decade, I have helped editorial teams, creative businesses, and mission-led organizations build better homes on the web. I work directly with the people using the site, from the first workshop through launch and beyond.</p>
        <div class="principles">
          <% principles.forEach((principle) => { %><div><strong><%= principle.value %></strong><span><%= principle.label %></span></div><% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
