<section class="hero reference-hero" id="home" aria-labelledby="hero-title">
  <span class="floating-code floating-code--one" aria-hidden="true">&lt;/&gt;</span>
  <span class="floating-code floating-code--two" aria-hidden="true">{ }</span>
  <span class="floating-code floating-code--three" aria-hidden="true">W</span>
  <div class="shell reference-hero__content">
    <p class="hero-kicker scroll-reveal">Portfolio</p>
    <h1 id="hero-title" class="scroll-reveal">
      <span><%= site.name %></span>
      <em><span class="hero-title-prefix">WordPress,</span> <span class="hero-typing"><b data-typing-text>crafted differently.</b></span></em>
    </h1>
    <p class="reference-hero__intro scroll-reveal"><%= site.description %></p>
    <div class="reference-hero__actions scroll-reveal">
      <a class="neon-button" href="#work">Explore projects <span aria-hidden="true">↘</span></a>
    </div>
  </div>
  <a class="reference-scroll" href="#about"><span>Scroll to explore</span><i aria-hidden="true"></i></a>
</section>
