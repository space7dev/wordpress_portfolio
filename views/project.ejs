<%- include('partials/head') %>
<%- include('partials/ambient-background') %>
<div id="top"></div>
<%- include('partials/header') %>
<main id="main-content" class="case-study">
  <header class="case-hero shell">
    <a class="back-link" href="/work">← All work</a>
    <p class="eyebrow"><%= project.type %> · <%= project.year %></p>
    <h1><%= project.title %></h1>
    <p class="case-hero__summary"><%= project.summary %></p>
    <div class="case-tags"><% project.services.forEach((service) => { %><span><%= service %></span><% }) %></div>
  </header>
  <div class="case-visual case-screenshot shell shell--wide">
    <img src="<%= project.screenshot %>" alt="<%= project.title %> website homepage" width="1200" height="800" fetchpriority="high">
  </div>
  <section class="case-overview shell" aria-label="Project overview">
    <div><p class="mini-label">The challenge</p><p><%= project.challenge %></p></div>
    <div><p class="mini-label">The approach</p><p><%= project.solution %></p></div>
  </section>
  <% if (project.metrics.length) { %><section class="case-results" aria-labelledby="results-title">
    <div class="shell"><p class="eyebrow">Measured impact</p><h2 id="results-title">Better for the team.<br>Better for the audience.</h2>
      <div class="metric-grid"><% project.metrics.forEach((metric) => { %><div><strong><%= metric.value %></strong><span><%= metric.label %></span></div><% }) %></div>
    </div>
  </section><% } %>
  <section class="case-stack shell" aria-labelledby="stack-title">
    <div><p class="eyebrow">Under the hood</p><h2 id="stack-title">Built for the long run.</h2></div>
    <ul><% project.stack.forEach((item) => { %><li><%= item %></li><% }) %></ul>
    <% if (project.url) { %><a class="button" href="<%= project.url %>" rel="noopener">Visit live website <span aria-hidden="true">↗</span></a><% } %>
  </section>
</main>
<%- include('partials/footer') %>
